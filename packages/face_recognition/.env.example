# ==============================================================================
# Zhulong FaceRecognition 算法包环境配置示例 (.env.example)
#
# 用途：
#   部署实施或高级调优时，可复制本文件为 .env 放置在算法包根目录下。
#   算法启动时将自动加载这里的环境变量，覆盖算法默认参数。
#
# 优先级顺序：
#   前端/任务级 JSON 配置 (最高) > 进程级 --config > 本文件环境变量 > 编译期默认值 (最低)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础业务与感知参数（已在 Web 界面暴露，也可在此设置全局默认值）
# ------------------------------------------------------------------------------

# 人脸比对识别相似度阈值 [0.0, 1.0]，默认 0.40（越高越严格，越低越宽松）
# ZHULONG_FACE_MATCH_THRESHOLD=0.40

# Top-K 候选人上限 [1, 20]，默认 3
# ZHULONG_FACE_TOP_K=3

# 人脸检出置信度阈值 [0.1, 1.0]，默认 0.50（弱光或远距离可适当降低）
# ZHULONG_FACE_DET_THRESHOLD=0.50

# 人体检出置信度阈值 [0.1, 1.0]，默认 0.50
# ZHULONG_PERSON_DET_THRESHOLD=0.50

# 最小人脸像素尺寸 [16, 512]，默认 32（低于此像素的人脸不送入识别）
# ZHULONG_MIN_FACE_SIZE=32

# 忽略陌生人 [true/false]，默认 false（设为 true 则仅记录已登记人员）
# ZHULONG_FILTER_UNMATCHED=false

# 启用多帧特征融合增强 [true/false]，默认 true（跨帧融合连续特征，提升识别稳定性）
# ZHULONG_ENABLE_FACE_FEATURE_FUSION=true


# ------------------------------------------------------------------------------
# 2. 高阶/专家调优参数（日常无需修改，仅限现场深度微调）
# ------------------------------------------------------------------------------

# eDifFIQA(T) 人脸质量评估得分门槛 [0.0, 1.0]，默认 0.28（低于此分不送入特征提取与底库登记）
# ZHULONG_MIN_FACE_QUALITY=0.28

# 跨帧同人特征融合余弦相似度门禁 [0.45, 0.95]，默认 0.62
# ZHULONG_FUSION_SIMILARITY_THRESHOLD=0.62

# 跨帧特征状态池未命中过期淘汰秒数 [0.5, 30.0]，默认 3.0
# ZHULONG_FUSION_TTL_SECONDS=3.0

# 候选人第一名与第二名最小相似度分差 [0.0, 1.0]，默认 0.00（0.0 表示关闭分差门禁）
# ZHULONG_MIN_MATCH_MARGIN=0.00

# 启用人脸图像质量门禁（清晰度与过曝/欠曝）[true/false]，默认 false
# ZHULONG_ENABLE_FACE_IMAGE_GATE=false

# 最小人脸清晰度阈值 (拉普拉斯方差)，默认 30.0（须结合现场镜头标定）
# ZHULONG_MIN_FACE_SHARPNESS=30.0

# 最大暗部欠曝像素占比 [0.0, 1.0]，默认 0.50
# ZHULONG_MAX_FACE_UNDEREXPOSURE=0.50

# 最大亮部过曝像素占比 [0.0, 1.0]，默认 0.30
# ZHULONG_MAX_FACE_OVEREXPOSURE=0.30

# 底库录入开启 112x112 水平镜像 TTA 特征融合 [true/false]，默认 true
# ZHULONG_ENABLE_ENROLL_FLIP_TTA=true

# 底库录入开启暗光自适应 Gamma 增强与无 EXIF 旋转重检兜底 [true/false]，默认 true
# ZHULONG_ENABLE_ENROLL_IMAGE_ENHANCE=true
