# Zhulong runtime configuration.
# The service reads this file from its working directory at startup.

[http]
address = "127.0.0.1:8000"

[logging]
development = false
level = "info"
# Empty format follows development: console in development, JSON otherwise.
format = ""
output = "stderr"

[logging.sampling]
enabled = false
initial = 0
thereafter = 0

[logging.rotation]
enabled = false
max_size_mb = 0
max_backups = 0
max_age_days = 0
compress = false
# Set a deployment-reviewed positive budget before selecting file output.
max_total_size_mb = 0

# Data directory for SQLite (zhulong.db), persistent keys (camera.key), and algorithms.
# Defaults to "./data" in the project directory.
# For production edge Linux deployment (e.g. RK3588 / Atlas), change to a persistent path like "/var/lib/zhulong" or "/data".
[data]
directory = "./data"

# Personnel management and face gallery configuration.
[person]
# Directory for enrolled face template photos.
# Defaults to "<data.directory>/faces" if omitted or left empty.
faces_directory = ""

# Must match manifest.json platform.target for algorithm packages.
[algorithm]
target = "cpu"
