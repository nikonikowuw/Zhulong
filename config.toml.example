# Zhulong runtime configuration.
# The service reads this file from its working directory at startup.

[http]
address = "127.0.0.1:8000"
# TLS mode: "off" (plain HTTP, default), "auto" (self-signed cert with local/LAN SANs for WebCodecs), or "manual".
tls_mode = "off"
# Manual certificate paths (used when tls_mode = "manual")
cert_file = ""
key_file = ""

[logging]
level = "info"
# Empty format defaults to json; set "console" for a human-readable log.
format = ""
output = "stderr"

[logging.sampling]
enabled = false
initial = 0
thereafter = 0

[logging.rotation]
enabled = false
max_size_mb = 0
max_backups = 0
max_age_days = 0
compress = false
# Set a deployment-reviewed positive budget before selecting file output.
max_total_size_mb = 0

# Data directory for SQLite (zhulong.db), persistent keys (camera.key), and algorithms.
# Defaults to "./data" in the project directory.
# For production edge Linux deployment (e.g. RK3588 / Atlas), change to a persistent path like "/var/lib/zhulong" or "/data".
[data]
directory = "./data"

# Personnel management and face gallery configuration.
[person]
# Directory for enrolled face template photos.
# Defaults to "<data.directory>/faces" if omitted or left empty.
faces_directory = ""

# Must match manifest.json platform.target for algorithm packages.
[algorithm]
target = "cpu"

# Hardware video decoding policy and admission control.
#
# Preview audio is deliberately absent from this section: the native layer only
# demuxes audio (G.711 and AAC AUs pass through untouched), so an audio channel
# never consumes a decode session and never competes with `max_sessions`.
# Whether a stream has audio is discovered by probing, not configured; whether it
# is heard is a user gesture. Both mean there is no switch to add here.
[decode]
backend = "auto"                 # "auto" | "mpp" | "ffmpeg"
allow_software_fallback = true   # Board deployment profiles must set false (fail-closed)
max_sessions = 8                 # Maximum concurrent physical decode streams (0 = no limit)

# Alert push and multi-channel dispatch configuration.
[alertpush]
# Externally reachable host base URL, e.g. "http://10.0.0.12:8000".
# When left empty, targets configured with image_mode = "url" are rejected on save.
public_base_url = ""
# Signed media URL expiration TTL (1m..168h).
signed_url_ttl = "24h"

